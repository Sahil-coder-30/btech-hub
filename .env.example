# ---------------------------------------------------------------
# B.Tech Hub environment variables
# Copy this file to .env.local and fill every value.
# ---------------------------------------------------------------

# Public base URL of the app. Must match the Google OAuth redirect URI host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (Passport.js + Google OAuth) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Random string, at least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
# Comma separated emails that get the admin role on login
ADMIN_EMAILS=your-email@gmail.com
# Fixed credentials for direct URL admin login (/api/auth/admin/login)
ADMIN_USERNAME=admin_btech_hub
ADMIN_PASSWORD=BTechHub@Admin2026_SecureKey

# --- Supabase (Postgres) ---
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only. Never expose this in client code.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# --- NVIDIA (main LLM for quizzes, doubts, plans, insights and Ask your Syllabus) ---
# https://build.nvidia.com -> API key. Gemini below is the automatic backup.
# Set LLM_PROVIDER=gemini to use Gemini alone.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# --- Gemini (backup LLM, AKTU result PDFs, optional embeddings) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Embeddings (documents and questions must use the same provider) ---
# https://console.mistral.ai -> API Keys. mistral-embed returns 1024 dims.
EMBEDDING_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-api-key

# --- Pinecone (RAG vector store) ---
# Create a serverless index with dimension 1024 and metric cosine
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=btechhub-vectors
PINECONE_NAMESPACE=study-material-mistral

# --- ML service (FastAPI, OCR + vision). Same token on both sides. ---
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=generate-with-openssl-rand-hex-32

# --- Vac agent model: nvidia, mistral or gemini. ---
# nvidia uses NVIDIA_AGENT_MODEL (or NVIDIA_MODEL) and falls back to the Mistral model below.
# Thinking stays on for the agent: without it the model skips tools. NVIDIA_AGENT_THINKING=false turns it off.
AGENT_PROVIDER=nvidia
NVIDIA_AGENT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
AGENT_MODEL=ministral-8b-latest
