# ---------------------------------------------------------------
# B.Tech Hub environment variables
# Copy this file to .env.local and fill every value.
# ---------------------------------------------------------------

# Public base URL of the app. Must match the Google OAuth redirect URI host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (Passport.js + Google OAuth) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Random string, at least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
# Comma separated emails that get the admin role on login
ADMIN_EMAILS=your-email@gmail.com

# --- Supabase (Postgres) ---
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only. Never expose this in client code.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# --- Gemini (LLM + embeddings) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Embeddings (documents and questions must use the same provider) ---
# https://console.mistral.ai -> API Keys. mistral-embed returns 1024 dims.
EMBEDDING_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-api-key

# --- Pinecone (RAG vector store) ---
# Create a serverless index with dimension 1024 and metric cosine
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=btechhub-vectors
PINECONE_NAMESPACE=study-material-mistral

# --- ML service (FastAPI, OCR + vision). Same token on both sides. ---
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=generate-with-openssl-rand-hex-32

# --- Vac agent model. Mistral keeps the Gemini daily quota free for quizzes and plans. ---
AGENT_PROVIDER=mistral
AGENT_MODEL=ministral-8b-latest
